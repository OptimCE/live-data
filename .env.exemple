# Template for local development — copy to .env.local (ENV defaults to "local").
# The real settings contract lives in core/config.py.
#
# Note that ENV is read at CLASS-DEFINITION time and core/config.py ends with
# `settings = Settings()`, so ENV must be in the environment BEFORE the first
# import of any project module. That is why tests/conftest.py sets it above its
# imports and why every doc-gen compose one-shot sets ENV=local.
#
# Running this service standalone is possible but rarely what you want: it needs
# a Mosquitto broker with the dynamic-security plugin enabled, because it creates
# and deletes broker clients at runtime. The development stack in the monorepo
# wires that up for you — see README.md.

# -- Core --
ENV=local

# -- CRM database (read-only: community, member, meter, meter_data,
#    community_subscription, audit_log) --
CRM_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crm_db
CRM_DB_POOL_SIZE=20
CRM_DB_MAX_OVERFLOW=10
CRM_DB_POOL_RECYCLE=3600
CRM_DB_POOL_TIMEOUT=30
CRM_DB_SSL=false

# -- Local database (owned: device, enrollment_token, measurement, device_last,
#    community_live_settings, ingest_dead_letter) --
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/live_data_local
LOCAL_DB_POOL_SIZE=20
LOCAL_DB_MAX_OVERFLOW=10
LOCAL_DB_POOL_RECYCLE=3600
LOCAL_DB_POOL_TIMEOUT=30
LOCAL_DB_SSL=false

# -- MQTT broker: the address this service DIALS --
# An address on the internal network. Never handed to a device — see the public
# block further down, and keep the two different.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false

# The dynamic-security ADMIN identity. Enrolment and revocation are driven
# entirely over the $CONTROL/dynamic-security/v1 topic API; there is no
# mosquitto_ctrl binary and no subprocess.
MQTT_ADMIN_USERNAME=optimce-admin
MQTT_ADMIN_PASSWORD=
MQTT_ADMIN_CLIENT_ID=live-data-admin

# The INGEST identity, and it is deliberately NOT the admin one. The dynsec
# admin's role grants publish on $CONTROL and nothing at all on `ce/#`, so a
# worker connecting as the admin SUBSCRIBEs successfully, gets a perfectly
# normal SUBACK, and is then delivered nothing — for ever, with no error at
# either end.
#
# NOTHING VALIDATES THESE TWO, in any environment. An empty username reaches a
# broker with `allow_anonymous false` and simply fails to connect.
MQTT_INGEST_USERNAME=live-data-ingest
MQTT_INGEST_PASSWORD=
MQTT_INGEST_CLIENT_ID=live-data-ingest

# Both client ids are FIXED, and that is load-bearing: MQTT evicts an existing
# session when a second client connects with the same identifier, so two
# replicas of either process kick each other off the broker continuously — both
# reporting healthy, because readiness deliberately does not gate on the broker.
# One replica each, or give each replica its own id.

# KrakenD cuts a request at 3000 ms and the enrolment retry path is two
# commands, which is where 800 comes from.
MQTT_COMMAND_TIMEOUT_MS=800

# -- MQTT broker: the address a DEVICE IS TOLD --
# This goes into the enrolment response and from there into a device's flash,
# which never asks again. It must differ from MQTT_HOST — in staging and
# production that is asserted at boot, because shipping a compose service name
# here is unrecoverable without visiting every basement.
BROKER_PUBLIC_HOST=mqtt.optimce.be
BROKER_PUBLIC_PORT=8883
BROKER_PUBLIC_TLS=true

# -- Ingest validation --
# These default to what the FROZEN protocol states. Changing one changes what
# conformant connectors were promised, so change docs/live-data-protocol.md in
# the monorepo first — three implementers code against it from outside this
# repository.
INGEST_MAX_FUTURE_SECONDS=300
INGEST_MAX_AGE_DAYS=35
INGEST_INTERVAL_SECONDS=900
INGEST_MAX_BATCH=200
INGEST_DEFAULT_MAX_WH_PER_INTERVAL=50000.0
INGEST_CAPACITY_TOLERANCE=1.1
INGEST_NIGHT_START_HOUR_LOCAL=23
INGEST_NIGHT_END_HOUR_LOCAL=4
INGEST_TIMEZONE=Europe/Brussels

# After this many consecutive database failures the worker DISCONNECTS from the
# broker on purpose. aiomqtt 2.x acknowledges a message before application code
# sees it, so there is no ack to withhold; dropping the connection hands the
# retry back to the device's own store-and-forward, which the protocol already
# promises is safe.
INGEST_DB_FAILURES_BEFORE_DISCONNECT=5

# -- The live-data subscription, as the worker and scheduler see it --
# Seconds the set of subscribed communities is trusted before the CRM is read
# again. Switching live data off (or on) on the Annex services page reaches the
# worker within this long; until then it keeps following the old state. 1..3600,
# asserted at boot. The dev compose sets 5 on the worker for the verify script.
SUBSCRIPTION_CACHE_TTL_SECONDS=60

# -- Enrolment --
ENROLMENT_TOKEN_TTL_HOURS=72
ENROLMENT_CLAIM_LEASE_SECONDS=30

# -- CORS --
# "*" is permitted in local only. Staging and production reject it at startup.
ALLOW_ORIGIN=*

# -- Observability (optional in local) --
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
