# Template for .env.staging — copy to .env.staging and fill in real values.
# Pydantic will refuse to start the service if any required key below is missing.
#
# The blank values are secrets, deliberately. This file is committed; a
# placeholder that boots is worse than a blank that does not, because a
# placeholder can reach production.
#
# THE BLANKS SURFACE ONE PER RESTART. `validate_env_config` is a single
# model validator that raises on the first failing check, so pydantic
# reports one missing key at a time rather than all of them. In staging
# only MQTT_ADMIN_PASSWORD is required, so that is one boot; the same file
# under ENV=production takes four. Measured, not inferred.

# -- Core --
ENV=staging

# -- CRM database (read-only) --
CRM_DATABASE_URL=postgresql+asyncpg://user:password@crm-db.staging.internal/optimce
CRM_DB_SSL=true

# -- Local database (owned) --
LOCAL_DATABASE_URL=postgresql+asyncpg://user:password@live-db.staging.internal/live_data
LOCAL_DB_SSL=true

# -- MQTT broker: the address this service DIALS --
# Internal. Never handed to a device.
MQTT_HOST=mosquitto.staging.internal
MQTT_PORT=8883
MQTT_TLS=true

# REQUIRED in staging: the service refuses to start without both.
MQTT_ADMIN_USERNAME=optimce-admin
MQTT_ADMIN_PASSWORD=
MQTT_ADMIN_CLIENT_ID=live-data-admin

# NOT validated in any environment, and the worker is useless without them: an
# empty username against a broker with `allow_anonymous false` simply fails to
# connect, and nothing at boot will tell you so.
MQTT_INGEST_USERNAME=live-data-ingest
MQTT_INGEST_PASSWORD=
MQTT_INGEST_CLIENT_ID=live-data-ingest

MQTT_COMMAND_TIMEOUT_MS=800

# -- MQTT broker: the address a DEVICE IS TOLD --
# ASSERTED AT BOOT, and it is the one check that prevents bricking a fleet. This
# value is written into every device's flash at enrolment and can never be
# changed remotely, so it must not be the internal MQTT_HOST above. Give the
# broker its own public DNS name and its own certificate lineage, separate from
# the web certificate.
#
# BROKER_PUBLIC_TLS must be true here — devices connect over TLS only, and the
# root CA they embed is part of the frozen protocol (§6).
BROKER_PUBLIC_HOST=mqtt.staging.optimce.example
BROKER_PUBLIC_PORT=8883
BROKER_PUBLIC_TLS=true

# -- Ingest validation --
# Defaults match the frozen protocol; change the protocol first.
INGEST_MAX_FUTURE_SECONDS=300
INGEST_MAX_AGE_DAYS=35
INGEST_INTERVAL_SECONDS=900
INGEST_MAX_BATCH=200
INGEST_DEFAULT_MAX_WH_PER_INTERVAL=50000.0
INGEST_CAPACITY_TOLERANCE=1.1
INGEST_NIGHT_START_HOUR_LOCAL=23
INGEST_NIGHT_END_HOUR_LOCAL=4
INGEST_TIMEZONE=Europe/Brussels
INGEST_DB_FAILURES_BEFORE_DISCONNECT=5

# -- The live-data subscription, as the worker and scheduler see it --
# Seconds the set of subscribed communities is trusted before the CRM is read
# again: switching live data off or on reaches the worker within this long.
# 1..3600, asserted at boot.
SUBSCRIPTION_CACHE_TTL_SECONDS=60

# -- Enrolment --
ENROLMENT_TOKEN_TTL_HOURS=72
ENROLMENT_CLAIM_LEASE_SECONDS=30

# -- CORS --
# Comma-separated list of allowed origins. Wildcards ("*") are rejected at
# startup, and there is no implicit fallback. Document the real frontend /
# gateway origin(s) here.
ALLOW_ORIGIN=https://app.staging.optimce.example

# -- Observability --
# All four are optional in staging, and leaving them blank here boots cleanly -
# verified. Do not be misled if you meet them elsewhere: the three checks on
# TOKEN, LOGS_URL and METRICS_URL say "required for staging/production" in
# their error text, but they sit under `if self.ENV == PRODUCTION`, so only
# production enforces them. LOGGING_TRACES_URL is validated nowhere at all.
#
# ALL THREE CONTAINERS NEED THESE, not just the API: live-data, live-data-worker
# and live-data-scheduler each call setup_tracer_provider() and each exports its
# own metrics under a `component` resource attribute. A worker deployed without
# them exports nothing and its absence is indistinguishable from a dead worker.
#
# Leaving them BLANK is now inert rather than harmful: core/tracing.py returns
# early and logs a warning. It used to start a 15-second export loop against the
# OTLP exporter's default endpoint, http://localhost:4318/, on every container.
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
