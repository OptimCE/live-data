# Loaded by core/config.py when ENV=test is exported (tests/conftest.py does it,
# at the very top, ABOVE every project import — Settings reads ENV at
# class-definition time and the module ends with `settings = Settings()`).
#
# Single Postgres instance on port 5433 — both CRM and LOCAL test data live in
# the same database `test_db_be` declared in tests/docker-compose.test.yml.

# -- Core --
ENV=test

# -- CRM database (mirrored CRM tables created by tests/sql/crm_test_schema.sql) --
CRM_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/test_db_be
CRM_DB_POOL_SIZE=5
CRM_DB_MAX_OVERFLOW=2
CRM_DB_POOL_RECYCLE=3600
CRM_DB_POOL_TIMEOUT=10
CRM_DB_SSL=false

# -- Local database (schema applied from scripts/sql/schema.sql) --
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/test_db_be
LOCAL_DB_POOL_SIZE=5
LOCAL_DB_MAX_OVERFLOW=2
LOCAL_DB_POOL_RECYCLE=3600
LOCAL_DB_POOL_TIMEOUT=10
LOCAL_DB_SSL=false

# -- MQTT broker --
# There is NO broker under tests, and that is a decision rather than a gap.
#
# GitHub Actions creates `services:` containers BEFORE `actions/checkout` runs,
# so a repo-tracked mosquitto.conf cannot be their bind-mount source — and this
# broker needs one. Not one of the six `tests/docker-compose.test.yml` files in
# the monorepo mounts anything, so live-data would be introducing the first
# mounted test container in the repo.
#
# So the suite drives `FakeDeviceBroker` and unit-tests the surface we expose to
# the broker (the connect kwargs, the correlationData matching, the hard
# timeout). That is the existing house policy, stated outright in the sibling
# services' tests/test_nats_resilience.py: the real reconnection behaviour "can
# only be verified end-to-end with a real broker".
#
# The end-to-end half runs against the monorepo dev stack, from
# scripts/verify-live-ingest.sh, beside postgres/verify/*.sh. Recorded as D-7.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_ADMIN_USERNAME=test-admin
MQTT_ADMIN_PASSWORD=test-admin-password
# Short, so a test that forgets to prime the fake fails in milliseconds rather
# than stalling the suite for the production 800 ms.
MQTT_COMMAND_TIMEOUT_MS=50

# -- What a device is told --
# Deliberately DIFFERENT from MQTT_HOST, mirroring the production invariant that
# core/config.py asserts: the address written into a device's NVS can never be
# changed remotely, so it must never be an internal one.
BROKER_PUBLIC_HOST=mqtt.test.optimce.be
BROKER_PUBLIC_PORT=8883
BROKER_PUBLIC_TLS=true

# -- CORS --
ALLOW_ORIGIN=http://localhost

# -- Observability --
# Empty: tracing/metrics exporters are no-ops without endpoints.
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
