# ---------- stage 1: build ----------
FROM python:3.12-slim AS builder

WORKDIR /build
COPY requirements/base.txt   requirements/base.txt
COPY requirements/worker.txt requirements/worker.txt

RUN pip install --no-cache-dir --prefix=/install -r requirements/worker.txt

# ---------- stage 2: runtime ----------
FROM python:3.12-slim

# tini gives us a real PID 1: forwards SIGTERM to the Python process so the
# drain in worker.main actually runs, and reaps zombies on shutdown.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

# Security: non-root user
RUN groupadd -r app && useradd -r -g app -d /app -s /sbin/nologin app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=builder /install /usr/local

# ===========================================================================
# NOTE THE DIVERGENCE FROM THE SIBLING ANNEXES: there is NO `COPY api/ api/`.
#
# administrative-document and billing both copy api/ into their worker images,
# because their scheduled sweeps construct the real service class and that class
# lives under api/. Each then carries a long comment explaining the three
# mitigations that keep fastapi from being reached at runtime — ports/providers.py,
# `UploadFile` under TYPE_CHECKING, and moving the upload cap into shared/const.py
# — because this image installs requirements/worker.txt, which has NO
# fastapi/uvicorn/starlette. Getting that wrong shipped once and crash-looped 62
# times: it passes pytest, ruff and mypy locally, where .venv has everything.
#
# live-data's worker has no such need. It ingests MQTT into its own tables; there
# is no scheduled sweep reusing an HTTP service object. So api/ is simply absent,
# and the whole class of failure is structural rather than mitigated:
# `tests/test_worker_import_graph.py` asserts that every first-party package the
# worker imports appears in the COPY list below, so an `import api.…` added to
# worker/ later fails that test rather than crash-looping a container.
#
# If a future step genuinely needs api/ here, adding the COPY is a deliberate act
# that comes with the siblings' three mitigations attached.
# ===========================================================================
COPY core/    core/
COPY domain/  domain/
COPY ports/   ports/
COPY shared/  shared/
COPY worker/  worker/
COPY locales/ locales/

RUN chown -R app:app /app
USER app

# Liveness: worker.main touches /tmp/worker.alive every ~15 s WHILE THE BROKER
# CONNECTION IS UP — not merely while the event loop is alive. ~3 missed touches
# = unhealthy.
#
# That gating is the point. A worker that cannot reach the broker is ingesting
# nothing, and an ungated heartbeat would report it healthy for ever. It also
# catches the two-replica case: two workers on one fixed MQTT client id kick each
# other off the broker continuously, and both would otherwise look fine.
#
# start-period covers the bounded connect-retry window.
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD python -c "import os, time, sys; sys.exit(0 if time.time() - os.path.getmtime('/tmp/worker.alive') < 60 else 1)"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "worker.main"]
